# Normalise line endings. Without this, editing on Windows rewrites every file
# with CRLF and git reports the whole repo as modified on each commit.
* text=auto eol=lf

# Binary files git must never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.pdf  binary
